<?xml version="1.0"?>
<package format="3">
  <name>rov_sonar_driver</name>
  <version>1.0.0</version>
  <description>ROS2 C++ driver for ROV omnidirectional scanning sonar (Scanfish-II Omni)</description>
  <maintainer email="rov@example.com">ROV Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>rov_sonar_interface</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
